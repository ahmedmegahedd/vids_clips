# Clipora local / production environment
# Copy to apps/web/.env.local and apps/api/.env

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Allow local use without auth until Supabase is connected
DEV_BYPASS_AUTH=true
# Leave unset to auto-detect ffmpeg + yt-dlp. Set to simulated only if you want preview-only clips.
# PROCESSOR_MODE=real

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- YouTube Data API (recommended in production for accurate duration) ---
YOUTUBE_API_KEY=

# --- Paymob ---
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PUBLIC_API_URL=http://localhost:4000

# --- Redis (optional; in-process queue is used when omitted) ---
REDIS_URL=
